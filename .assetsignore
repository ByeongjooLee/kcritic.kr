.git
node_modules
/essays
.env
.env.example
*.py
__pycache__
*.pyc
*.xml
*.txt
*.jsonl
/schema
CLAUDE.md
wrangler.jsonc
package.json
package-lock.json
.wrangler

# 검증·교정 작업 산출물 (배포 제외)
*.bak
*.csv
verify_lod_result.json
essays_backup_qidfix
.gitignore
.assetsignore
.vscode
.dev.vars*
id_map.json
.claude

# Worker 코드·비공개 색인은 정적 자산이 아님
/worker
/find

# 개념어 나눔 표(빌드 입력, 원문 없음) — 정적 자산 아님
concept_split.json

# Local automated checks are not site assets
/tests

# Codex instructions (same role as CLAUDE.md) - not a site asset
AGENTS.md

# 배포 스크립트는 사이트 자산이 아니다 — 빼지 않으면 /deploy.ps1 로 그대로 읽혔다.
*.ps1

# 사이트맵·robots 는 배포한다 — 위의 *.xml / *.txt 금지를 덮는 예외(반드시 맨 뒤에).
# 원문 essays/*.xml·*.txt 는 그대로 막힌다 — 배포 뒤 /essays/<id>.xml 이 404 인지 확인할 것.
!/sitemap.xml
!/robots.txt

# .env.example — 실제 값 채워서 .env 로 복사 (cp .env.example .env)
# .env 는 절대 커밋 금지 (.gitignore 등록됨). GraphRAG API(neo4j_api.py)·크라우드소싱·일부 검증 스크립트에서 사용.
# 정적 사이트 빌드(build.py)·배포(wrangler)에는 .env 불필요 — 아래는 부가 기능용.

# Neo4j Aura (클라우드 그래프 DB) — GraphRAG API
AURA_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
AURA_USERNAME=neo4j
AURA_PASSWORD=

# Anthropic Claude API — GraphRAG Cypher 생성·학술 답변 (neo4j_api.py)
ANTHROPIC_API_KEY=

# Gemini API — 크라우드소싱 기여 서식 자동 정규화
GEMINI_API_KEY=

# 관리자 대시보드(admin.html) 토큰 인증
ADMIN_TOKEN=

# 외부 LOD API 키 (선택) — 인물 검증 스크립트용
AKS_API_KEY=
NLK_API_KEY=

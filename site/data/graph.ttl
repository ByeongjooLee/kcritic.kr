kce:kim-uchang_on-questioning_1977 a critic:CriticalEssay ;
  dcterms:title "물음에 대하여 — 방법에 대한 시론"@ko ;
  rdfs:label "물음에 대하여 — 방법에 대한 시론"@ko ;
  dcterms:date "1977"^^xsd:gYear ;
  schema:isPartOf "물음에 대하여 — 방법에 대한 시론" ;
  schema:url <https://kcritic.kr/site/essays/kim-uchang_on-questioning_1977.html> ;
  dcterms:creator kc:p-00117 ;
  cito:citesAsAuthority kc:p-dewey ;
  cito:citesAsAuthority kc:p-habermas ;
  cito:citesAsAuthority kc:p-heidegger ;
  cito:citesAsAuthority kc:p-kuhn ;
  cito:citesAsAuthority kc:p-lavoisier ;
  cito:citesAsAuthority kc:p-marcuse ;
  cito:citesAsAuthority kc:p-priestley ;
  cito:citesAsAuthority kc:p-sartre ;
  dcterms:subject "참다운 의미에서의 문제가 아니며, 여기에서 참으로 문제적인 것은 아무것도 없다."@ko ;
  dcterms:subject "질문"@ko ;
  dcterms:subject "정해진 문답의 세계는 개인의 주체적인 실천을 봉쇄함으로써 완전한 소외의 세계일 수밖에 없다."@ko ;
  dcterms:subject "소외"@ko ;
  dcterms:subject "문제"@ko ;
  dcterms:subject "상황"@ko ;
  dcterms:subject "연구"@ko ;
  dcterms:subject "산화 작용이라는 새로운 생각에 이르렀다."@ko ;
  dcterms:subject "콘텍스트"@ko ;
  dcterms:subject "문제의 상황을 이루는 전체야말로 문제의 타당성과 해결의 방향을 규정한다."@ko ;
  dcterms:subject "전체"@ko ;
  dcterms:subject "패러다임(paradigm)"@ko ;
  dcterms:subject "과학적으로 설명된 세계는 있는 그대로의 세계의 전부가 아니라 있을 수 있는 세계의 하나에 불과하며, 패러다임은 우리가 제기하는 문제를 선택하고 나아가 어떤 물음은 물을 수도 없는 것이 되게 한다."@ko ;
  dcterms:subject "문제는 상황 속에서 파악되어야 하되 그 상황 자체도 문제로서 검토되어야 하며, 그러기 위해 우리는 문제를 전체성에 이를 때까지 밀고 나가야 한다."@ko ;
  dcterms:subject "주체적인 자유"@ko ;
  dcterms:subject "물음으로서의 문제는 묻는 사람을 떠나서 일어날 수 없으며, 사람의 주체적인 상황 판단과 실천의 결단에서 온다."@ko ;
  dcterms:subject "주체성의 회복은 끊임없이 상황의 주체성을 나의 것으로 내면화하는 과정이며, 이 창조의 힘은 크게는 창조적 진화의 충동이요 작게는 내 동료 인간의 주체적 창조력이다."@ko ;
  dcterms:subject "보편성의 주체"@ko ;
  dcterms:subject "여기에서 학문은 교리 문답이 되고, 개념들은 상황과 더불어 변하는 유연한 도구가 아니라 억지로 씹어야 하는 먹을 수 없는 음식 같은 것이 되며, 배움의 과정은 계속적인 자기 소외 작용이 된다."@ko ;
  dcterms:subject "하버마스는 인간의 관심을 넘어서는 듯한 학문적 연구가 실은 그 관심에 깊이 연결되어 있으며, 이에 대한 반성을 게을리하는 객관주의·실증주의가 비인간적 사회 질서에 관계함을 보여 준다."@ko ;
  dcterms:subject "해방의 인식에 대한 관심"@ko ;
  dcterms:subject "이 가운데 제일 중요한 것은 해방의 관심이니, 결국 모든 것은 사람의 살 만하고 좋은 삶에 대한 추구에 귀착되기 때문이다."@ko ;
  dcterms:subject "물음"@ko ;
  dcterms:subject "구극적 의미에서의 전체는 양적인 총화가 아니라 목적(telos)이며, 이 목적은 인간 자체, 인간의 역사적·진화적 운명 이외의 다른 아무것도 아니다."@ko ;
  dcterms:subject "허무"@ko ;
  dcterms:subject "이와 마찬가지로 우리는 물음이 열어 놓는 허무의 차원을 깨달음으로써 비로소 사회와 역사를 굳어 있는 틀이 아니라 인간의 자유로운 창조의 소산으로 다시 돌이킬 수 있다."@ko .


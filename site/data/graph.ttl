  cito:citesAsAuthority kc:p-00088 ;
  cito:citesAsAuthority kc:p-00093 ;
  cito:citesAsAuthority kc:p-00152 ;
  cito:citesAsAuthority kc:p-00157 ;
  cito:citesAsAuthority kc:p-althusser ;
  cito:citesAsAuthority kc:p-auerbach ;
  cito:citesAsAuthority kc:p-bacon ;
  cito:citesAsAuthority kc:p-benjamin ;

kce:kim-uchang_flower-hometown-land_1981 a critic:CriticalEssay ;
  dcterms:title "꽃과 고향과 땅"@ko ;
  rdfs:label "꽃과 고향과 땅"@ko ;
  dcterms:date "1981"^^xsd:gYear ;
  schema:isPartOf "꽃과 고향과 땅" ;
  schema:url <https://kcritic.kr/site/essays/kim-uchang_flower-hometown-land_1981.html> ;
  dcterms:creator kc:p-00117 ;
  cito:citesAsAuthority kc:p-00066 ;
  cito:citesAsAuthority kc:p-carlos-castaneda ;
  cito:citesAsAuthority kc:p-erwin-straus ;
  cito:citesAsAuthority kc:p-eugene-minkowski ;
  cito:citesAsAuthority kc:p-schiller ;
  dcterms:subject "사람과 자연의 풍경에 대한 관계는 실용이나 소박한 합리성을 넘어서는 근원적인 관계이다."@ko ;
  dcterms:subject "기쁨"@ko ;
  dcterms:subject "풍경의 신비"@ko ;
  dcterms:subject "고향에 있어서 정감과 풍경은 서로 뗄 수 없는 것으로서, 나와 물건, 주관과 객관, 감정과 사실이 분리되어 있지 않은 하나의 세계에서 우러나온다."@ko ;
  dcterms:subject "시간을 포함한 살아 있는 공간"@ko ;
  dcterms:subject "고향이란 우리에게 행복의 원형을 의미한다."@ko ;
  dcterms:subject "전체성"@ko ;
  dcterms:subject "풍경에 있어서 사람과 자연은 공감적으로 존재하지만, 지도로 옮겨진 자연은 아무런 정서적 감흥을 주지 아니한다."@ko ;
  dcterms:subject "느낌은 공감적 체험이다. 느낌의 상태에서 우리는 세계 안에 세계와 더불어 있다."@ko ;
  dcterms:subject "우울증이나 비개성화(非個性化)"@ko ;
  dcterms:subject "'감각의 원초적인 세계'"@ko ;
  dcterms:subject "장엄"@ko ;
  dcterms:subject "'세계'와 '지구'"@ko ;
  dcterms:subject "천박화"@ko ;
  dcterms:subject "현대 사회가 우리의 관심을 천박하게 하는 것은 그것이 우리를 소외시키는 체험으로 가득 차 있기 때문이다."@ko ;
  dcterms:subject "사람이 자연의 전체성에 연결되는 가장 신비한 매듭인 집과 땅이 광적(狂的)인 부동산 시장의 투기 대상이 된다."@ko ;
  dcterms:subject "소유를 위한 경쟁 속에서 땅의 광막함은 이리저리 찢기우고 장벽으로 가로막힌 학대받는 물건이 된다."@ko ;
  dcterms:subject "우리는 꽃과 산과 땅을 소유하기를 그치고 그것들의 작은 행복과 커다란 두려움에 소유되는 것을 배워야 한다. 그것이 삶의 시작이고 전체이다."@ko .


kce:kim-uchang_aesthetic-meaning_1993 a critic:CriticalEssay ;
  dcterms:title "나아감과 되풀이 — 심미적인 것의 의미"@ko ;
  rdfs:label "나아감과 되풀이 — 심미적인 것의 의미"@ko ;

  cito:citesAsAuthority kc:p-goodman ;
  cito:citesAsAuthority kc:p-goodman2 ;
  cito:citesAsAuthority kc:p-hannerz ;
  cito:citesAsAuthority kc:p-ibsen ;
  cito:citesAsAuthority kc:p-illich ;
  cito:citesAsAuthority kc:p-jhenry ;
  cito:citesAsAuthority kc:p-kohl ;
  cito:citesAsAuthority kc:p-kozol ;
  cito:citesAsAuthority kc:p-lasch ;
  cito:citesAsAuthority kc:p-marcuse ;
